{
  "expo": {
    "name": "Kiki Tips",
    "slug": "kiki-tips",
    "scheme": "kikitips",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kikitips.app"
